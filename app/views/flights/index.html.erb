<h1>Flights#index</h1>
<p>Find me in app/views/flights/index.html.erb</p>

<%= form_with url: flights_path, method: :get, local: true do %>
  <div>
    <%= label_tag :departure_airport_id, "From" %>
    <%= select_tag :departure_airport_id, 
        options_from_collection_for_select(
          @airports,
          :id,
          :code,
          params[:departure_airport_id]
        ),
        prompt: "Select departure airport"
    %>
  </div>

  <div>
    <%= label_tag :arrival_airport_id, "To" %>
    <%= select_tag :arrival_airport_id, 
        options_from_collection_for_select(
          @airports,
          :id,
          :code,
          params[:arrival_airport_id]
        ),
        prompt: "Select arrival airport"
    %>
  </div>

  <div>
    <%= label_tag :start_datetime, "Date" %><br>
    <%= select_tag :start_datetime,
      options_for_select(
        @available_dates.map { |date| [date.strftime("%A, %B %d, %Y"), date] },
        params[:start_datetime]
      ),
      prompt: "Select a date" %>
  </div>

  <div>
    <%= label_tag :num_tickets, "Passanger" %>
    <%= select_tag :num_tickets,
        options_for_select(
          (1..4), 
          params[:num_tickets]
        )
     %>
  </div>

  <%= submit_tag "Search Flights" %>
<% end %>


<% if @flights.any? %>
  <h2>Available Flights</h2>

    <p>Number of Passangers: <%= @num_tickets %></p>

    <ul>
      <% @flights.each do |flight| %>
        <li>
          <%= "#{flight.departure_airport.code} ➡️ #{flight.arrival_airport.code}
              | #{flight.start_datetime.strftime("%A, %B %d, %Y %H:%M")}
              " %>
        </li>
        <br>
      <% end %>
    </ul>
 
  
<% end%>
